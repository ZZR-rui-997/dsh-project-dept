    "locale/*.json",
    "icon.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "node --check index.js",
    "test": "node tests/bundle.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
