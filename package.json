{
  "name": "dsh-project-dept",
  "version": "1.0.4",
  "description": "Acceptance-first workflow skills for DSH: project-dept runs one board at a time through gates and three-layer review, loop-ops automates the review-and-revise cycle with hard round limits.",
  "type": "module",
  "license": "MIT",
  "author": "ZZR-rui-997",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZZR-rui-997/dsh-project-dept.git"
  },
  "bugs": {
    "url": "https://github.com/ZZR-rui-997/dsh-project-dept/issues"
  },
  "homepage": "https://github.com/ZZR-rui-997/dsh-project-dept#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "skill",
    "workflow",
    "acceptance",
    "code-review",
    "governance"
  ],
  "main": "./index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./skills/*": "./skills/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
